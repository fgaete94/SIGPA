# Copiar a .env y completar. El .env NUNCA se sube al repo.
# Mismos nombres que en el despliegue (ver DESPLIEGUE.md).

# --- Imagen ---
# Versión fija de n8n, la misma que en el Dockerfile (probada: 2.41.6).
N8N_VERSION=2.41.6

# --- Acceso al editor de n8n (http://localhost:5678) ---
# No se configura aquí: desde n8n 1.0+ el login es una cuenta owner
# (email + password) que se crea en la UI la primera vez que se entra.

# --- Workflow de rutas (optimizacion-rutas) ---
# Los lee el workflow con {{ $env.X }} (requiere N8N_BLOCK_ENV_ACCESS_IN_NODE=false,
# que ya fija el docker-compose).
# Coordenadas del depósito (punto de partida y llegada de la ruta). Obligatorias:
# si faltan o no son números, el webhook responde 500 configuracion_incompleta.
DEPOT_LAT=
DEPOT_LON=
# API key de OpenRouteService (https://openrouteservice.org, nivel gratuito). Obligatoria.
OPENROUTESERVICE_API_KEY=
# Opcionales: confianza mínima de la geocodificación (default 0.6) y país (default CL).
CONFIDENCE_MIN=
PAIS=

# El secreto X-Route-Secret NO va aquí: es la credencial "SIGPA X-Route-Secret"
# (Header Auth) en n8n, con el mismo valor que N8N_ROUTE_WEBHOOK_SECRET del backend.
# Las credenciales quedan cifradas en el volumen de n8n, no en el repo.
