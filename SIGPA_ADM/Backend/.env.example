META_WHATSAPP_TOKEN=your_meta_token_here
META_PHONE_NUMBER_ID=your_phone_number_id_here
META_WABA_ID=your_whatsapp_business_account_id_here
META_VERIFY_TOKEN=your_custom_verify_token_here
META_API_URL=https://graph.facebook.com/v21.0
DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname
OPENAI_API_KEY=your_openai_api_key_here
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
INTERNAL_CRON_SECRET=your_internal_cron_secret_here
# Orígenes permitidos por CORS para el panel web, separados por coma.
CORS_ORIGINS=http://localhost:5173
# Teléfono (WhatsApp, formato 569XXXXXXXX) de la ejecutiva que recibe las
# derivaciones. Si queda vacío se avisa en el log al iniciar.
EJECUTIVA_PHONE=56900000000
# Webhook de n8n que geocodifica y optimiza la ruta de reparto (POST /rutas/planificar).
# El backend lo llama con el header X-Route-Secret: <N8N_ROUTE_WEBHOOK_SECRET>.
N8N_ROUTE_WEBHOOK_URL=https://your-n8n-host/webhook/sigpa-ruta
N8N_ROUTE_WEBHOOK_SECRET=your_n8n_route_webhook_secret_here
# Segundos que se espera la respuesta de n8n antes de responder error (default 45).
N8N_ROUTE_TIMEOUT_SECONDS=45
# Máximo de pedidos por planificación de ruta (default 30).
RUTA_MAX_PEDIDOS=30
# Nombre con que se presenta el asistente virtual del WhatsApp (default Lea).
NOMBRE_ASISTENTE=Lea
# Horario de atención de las ejecutivas, en hora de Chile (America/Santiago).
# Fuera de él, al cliente que es derivado a una ejecutiva se le informa el
# horario. Inicio inclusive, fin exclusive (HH:MM).
HORARIO_ATENCION_INICIO=09:00
HORARIO_ATENCION_FIN=18:00
# Días de atención: separados por coma o como rango (ej. lunes-viernes).
# Default: todos los días.
DIAS_ATENCION=lunes,martes,miercoles,jueves,viernes,sabado,domingo
